### Initialization ###
units si
atom_style molecular
dimension 3
boundary p p p
newton on

### System: rigid H2 state pre-generated by gen_h2_init.py ###
read_data h2_init.data

### Force field ###
pair_style lj/cut 1.0e-9
pair_coeff 1 1 5.25e-22 2.827e-10
special_bonds lj 0.0 0.0 0.0
bond_style zero
bond_coeff 1 7.4e-11

### Group + per-molecule chunk ###
group h2gas type 1
compute molchunk h2gas chunk/atom molecule

compute Trot h2gas temp/chunk molchunk com yes adof 1.0 cdof 0.0

# Whole-system kinetic temperature (compute temp accounts for rigid DOF).
compute Ttot all temp

# Decompose:  T_tot = (3 T_trans + 2 T_rot) / 5   =>   T_trans = (5 T_tot - 2 T_rot) / 3
variable Ttrans equal (5*c_Ttot-2*c_Trot)/3

### Neighbor list ###
# Skin must be small compared to the box (here 100 nm). At very large boxes
# (>>1 micron) a larger skin is faster, but at this scale 2 Angstroms is the
# right order of magnitude.
neighbor     1.0e-10 bin
neigh_modify delay 0 every 20 check yes
atom_modify  sort 100 0.0

### Time integration ###
# rigid H2 (no vibration)
fix myintegrator all rigid/small molecule

### Output ###
thermo 1000
thermo_style custom step v_Ttrans c_Trot c_Ttot ke etotal
thermo_modify lost warn
fix dumpinfo all print 1000 "$(step) $(time) $(v_Ttrans) $(c_Trot)" file ../data/lammps/h2_energy_relaxation.dat screen no title "timestep simtime Ttrans Trot"

### Run ###
timestep 1.0e-15
run      5000000
