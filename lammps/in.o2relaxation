### Initialization ###
units si
atom_style molecular
dimension 3
boundary p p p
newton on
#package omp 8
#suffix omp

### System: rigid O2 state pre-generated by gen_o2_init.py ###
read_data o2_init.data

### Force field ###
# LJ parameters from o2_ctc/Sources/Molprops.f90 (O2-O2 isotropic well):
#   eps = 11.7e-3 eV = 1.875e-21 J,  Rm = 3.90e-10 m
#   sigma = Rm / 2^(1/6) = 3.474e-10 m
pair_style lj/cut 1.0e-9
pair_coeff 1 1 1.875e-21 3.474e-10
special_bonds lj 0.0 0.0 0.0
bond_style zero
bond_coeff 1 1.2075e-10

### Group + per-molecule chunk ###
group o2gas type 1
compute molchunk o2gas chunk/atom molecule

compute Trot o2gas temp/chunk molchunk com yes adof 1.0 cdof 0.0

# Whole-system kinetic temperature (compute temp accounts for rigid DOF).
compute Ttot all temp

# Decompose:  T_tot = (3 T_trans + 2 T_rot) / 5   =>   T_trans = (5 T_tot - 2 T_rot) / 3
variable Ttrans equal (5*c_Ttot-2*c_Trot)/3

### Neighbor list ###
neighbor     1.0e-10 bin
neigh_modify delay 0 every 20 check yes
atom_modify  sort 100 0.0

### Time integration ###
# rigid O2 (no vibration)
fix myintegrator all rigid/small molecule

### Output ###
thermo 1000
thermo_style custom step v_Ttrans c_Trot c_Ttot ke etotal
thermo_modify lost warn
fix dumpinfo all print 1000 "$(step) $(time) $(v_Ttrans) $(c_Trot)" file output/lammps_O2_energy_relaxation.dat screen no title "timestep simtime Ttrans Trot"

### Run ###
timestep 1.0e-15
run      1000000
