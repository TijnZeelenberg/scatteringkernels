SPARTA (24 Sep 2025)
Running on 1 MPI task(s)
### Initialization ###
seed                12345
dimension           3
units               si

### Problem definition ###
boundary            p p p # periodic boundaries in all directions
variable            L equal 100e-9 # [m] box length
variable            Lh equal ${L}/2 # half box length
variable            Lh equal 1e-07/2 
create_box          -${Lh} ${Lh} -${Lh} ${Lh} -${Lh} ${Lh}
create_box          -5e-08 ${Lh} -${Lh} ${Lh} -${Lh} ${Lh}
create_box          -5e-08 5e-08 -${Lh} ${Lh} -${Lh} ${Lh}
create_box          -5e-08 5e-08 -5e-08 ${Lh} -${Lh} ${Lh}
create_box          -5e-08 5e-08 -5e-08 5e-08 -${Lh} ${Lh}
create_box          -5e-08 5e-08 -5e-08 5e-08 -5e-08 ${Lh}
create_box          -5e-08 5e-08 -5e-08 5e-08 -5e-08 5e-08
Created orthogonal box = (-5e-08 -5e-08 -5e-08) to (5e-08 5e-08 5e-08)
create_grid         5 5 5
Created 125 child grid cells
  CPU time = 0.000786488 secs
  create/ghost percent = 82.6118 17.3882
species             o2.species O2
global              fnum 1  # Use 1 molecule per particle
mixture             gas O2 vstream 0.0 0.0 0.0 temp 300 trot 100

### Settings ###
collide             vss gas o2.vhs
collide_modify      rotate smooth vibrate no # enable rotational energy, disable vibrational energy

create_particles    gas n 20000 twopass
Created 20000 particles
  CPU time = 0.00356261 secs

### Output ###
compute             1 grid all gas temp trot
compute             2 reduce ave c_1[1] # average translational temperature
compute             3 reduce ave c_1[2] # average rotational temperature
variable            total_temp equal 1.5*c_2+c_3 # Equipartition theorem: energy = dof* 1/2 * k_B * T, where dof is the number of degrees of freedom (3 for translation, 2 for rotation)

variable            T_trans equal c_2 # rename for clarity
variable            T_rot equal c_3 # rename for clarity
variable            sim_time equal time # turn simulation time into a variable for output

fix                 1 ave/time 1 1 1 v_sim_time v_T_trans v_T_rot file ../data/sparta/o2_energy_relaxation.dat

